<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules (devices below API 31).

    The preference file holds the RTSP / dashboard credentials in plain text, and the
    events directory holds camera snapshots. Neither belongs in a cloud backup, so both
    are excluded; everything else is allowed to back up normally.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="cctv_app_prefs.xml" />
    <exclude domain="file" path="events/" />
</full-backup-content>
