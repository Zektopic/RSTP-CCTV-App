<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / transfer rules for API 31+.

    Credentials (cctv_app_prefs) and captured snapshots (events/) are excluded from
    cloud backup. Device-to-device transfer keeps the settings but still excludes the
    credentials, so a moved install prompts for a fresh password rather than carrying
    the old one across devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cctv_app_prefs.xml" />
        <exclude domain="file" path="events/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cctv_app_prefs.xml" />
        <exclude domain="file" path="events/" />
    </device-transfer>
</data-extraction-rules>
